# Postgres connection string. The Neon serverless driver is used, so a Neon
# pooled URL works directly.
DATABASE_URL=postgres://user:password@host/dbname

# Signs session cookies. Any long random string.
SESSION_SECRET=

# Encrypts stored Canvas access tokens. Falls back to SESSION_SECRET if unset,
# which entangles two unrelated secrets -- set it separately.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Canvas instance. Defaults to Widener's if unset.
# CANVAS_BASE_URL=https://widener.instructure.com

# Defaults to 5000.
# PORT=5000
